<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- siara-cc/Unishox2C版比較は明示的に指定した場合だけ実行する。通常テストにCコンパイラは不要。 -->
    <DefineConstants Condition="'$(RequireNativeHarness)' == 'true'">$(DefineConstants);REQUIRE_NATIVE_HARNESS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sakilabo.Unishox2\Sakilabo.Unishox2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="UpstreamTestCases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>